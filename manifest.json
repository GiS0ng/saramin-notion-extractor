{
  "manifest_version": 3,
  "name": "사람인 채용공고 추출기",
  "version": "0.4.0",
  "description": "사람인 채용공고를 Notion 채용공고 분석 DB 형식으로 추출합니다.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.saramin.co.kr/*", "https://*.saraminimage.co.kr/*", "https://api.notion.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["ocr/*", "ocr/core/*", "ocr/lang/*"],
      "matches": ["https://www.saramin.co.kr/*"]
    }
  ],
  "action": {
    "default_title": "채용공고 추출",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.saramin.co.kr/zf_user/jobs/view*",
        "https://www.saramin.co.kr/zf_user/jobs/relay/view*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
